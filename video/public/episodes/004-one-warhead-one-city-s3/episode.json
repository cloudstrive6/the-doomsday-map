{
 "subtitles": [
  {
   "start": 0.631,
   "end": 1.98,
   "text": "On the twenty-sixth of September,"
  },
  {
   "start": 1.98,
   "end": 3.25,
   "text": "nineteen eighty-three,"
  },
  {
   "start": 3.794,
   "end": 5.32,
   "text": "a Soviet satellite warned"
  },
  {
   "start": 5.32,
   "end": 7.099,
   "text": "of one American missile,"
  },
  {
   "start": 7.099,
   "end": 8.41,
   "text": "then four more."
  },
  {
   "start": 9.265,
   "end": 12.48,
   "text": "Duty officer Stanislav Petrov judged"
  },
  {
   "start": 12.48,
   "end": 14.25,
   "text": "it a false alarm,"
  },
  {
   "start": 14.25,
   "end": 15.76,
   "text": "reasoning that a real"
  },
  {
   "start": 15.76,
   "end": 17.47,
   "text": "attack would be hundreds."
  },
  {
   "start": 18.574,
   "end": 20.87,
   "text": "A later inquiry found a malfunction."
  },
  {
   "start": 21.6,
   "end": 23.53,
   "text": "In January nineteen ninety-five,"
  },
  {
   "start": 24.324,
   "end": 26.54,
   "text": "a Norwegian science rocket was"
  },
  {
   "start": 26.54,
   "end": 28.35,
   "text": "tracked by Russian radar."
  },
  {
   "start": 28.705,
   "end": 30.3,
   "text": "Russia's leaders were reportedly"
  },
  {
   "start": 30.3,
   "end": 32.47,
   "text": "brought their nuclear briefcases."
  },
  {
   "start": 32.695,
   "end": 34.07,
   "text": "No order was given."
  }
 ],
