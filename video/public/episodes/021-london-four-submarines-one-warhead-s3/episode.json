{
 "subtitles": [
  {
   "start": 0.405,
   "end": 2.374,
   "text": "At 7.6 minutes,"
  },
  {
   "start": 2.374,
   "end": 4.234,
   "text": "the first warhead reaches Faslane"
  },
  {
   "start": 4.234,
   "end": 5.824,
   "text": "and bursts on the ground."
  },
  {
   "start": 6.052,
   "end": 7.754,
   "text": "The fireball reaches about half a"
  },
  {
   "start": 7.754,
   "end": 9.704,
   "text": "kilometre from the point of burst."
  },
  {
   "start": 10.061,
   "end": 11.674,
   "text": "Blast of 20 pounds per square"
  },
  {
   "start": 11.674,
   "end": 13.681,
   "text": "inch reaches just over that."
  },
  {
   "start": 13.681,
   "end": 15.374,
   "text": "Five pounds per square inch reaches"
  },
  {
   "start": 15.374,
   "end": 16.904,
   "text": "two and a half kilometres."
  },
  {
   "start": 18.253,
   "end": 20.664,
   "text": "A ground burst throws up earth,"
  },
  {
   "start": 20.974,
   "end": 21.774,
   "text": "and the earth comes"
  },
  {
   "start": 21.774,
   "end": 23.264,
   "text": "down as fallout."
  },
  {
   "start": 23.557,
   "end": 25.489,
   "text": "The engine marks Faslane"
  },
  {
   "start": 25.489,
   "end": 27.404,
   "text": "as heavy local fallout."
  },
  {
   "start": 27.933,
   "end": 28.554,
   "text": "If the wind is"
  },
  {
   "start": 28.554,
   "end": 29.704,
   "text": "from the west,"
  },
  {
   "start": 30.001,
   "end": 32.274,
   "text": "the commonest direction in southern Britain,"
  },
  {
   "start": 32.274,
   "end": 33.754,
   "text": "the plume drifts east"
  },
  {
   "start": 33.754,
   "end": 35.204,
   "text": "over central Scotland."
  },
  {
   "start": 35.576,
   "end": 37.084,
   "text": "We choose that wind."
  },
  {
   "start": 37.084,
   "end": 38.374,
   "text": "We model no dose"
  },
  {
   "start": 38.374,
   "end": 39.724,
   "text": "and no towns."
  }
 ],
