{
 "subtitles": [
  {
   "start": 0.0,
   "end": 2.028,
   "text": "Here is what fifteen kilotons"
  },
  {
   "start": 2.028,
   "end": 3.567,
   "text": "does to open farmland,"
  },
  {
   "start": 3.567,
   "end": 5.315,
   "text": "from the scenario engine."
  },
  {
   "start": 5.865,
   "end": 6.73,
   "text": "The fireball:"
  },
  {
   "start": 6.73,
   "end": 8.06,
   "text": "a hundred and eighty"
  },
  {
   "start": 8.06,
   "end": 9.19,
   "text": "metres in radius."
  },
  {
   "start": 9.19,
   "end": 10.72,
   "text": "About three hundred and"
  },
  {
   "start": 10.72,
   "end": 12.05,
   "text": "sixty metres across."
  },
  {
   "start": 12.05,
   "end": 13.979,
   "text": "Everything inside it is gone."
  },
  {
   "start": 14.529,
   "end": 16.772,
   "text": "Three hundred and forty metres out,"
  },
  {
   "start": 16.772,
   "end": 18.31,
   "text": "the blast reaches twenty"
  },
  {
   "start": 18.31,
   "end": 19.784,
   "text": "pounds per square inch."
  },
  {
   "start": 19.784,
   "end": 22.027,
   "text": "Almost nothing built survives that."
  },
  {
   "start": 22.577,
   "end": 25.041,
   "text": "At one point six seven kilometres,"
  },
  {
   "start": 25.041,
   "end": 27.071,
   "text": "five pounds per square inch."
  },
  {
   "start": 27.071,
   "end": 29.39,
   "text": "Most ordinary buildings collapse"
  },
  {
   "start": 29.39,
   "end": 30.912,
   "text": "or are badly damaged."
  },
  {
   "start": 30.912,
   "end": 32.942,
   "text": "That ring covers about eight"
  },
  {
   "start": 32.942,
   "end": 35.116,
   "text": "point eight square kilometres."
  },
  {
   "start": 35.666,
   "end": 38.262,
   "text": "The flash burns farther than that."
  },
  {
   "start": 38.262,
   "end": 40.4,
   "text": "Third-degree burns reach one"
  },
  {
   "start": 40.4,
   "end": 42.08,
   "text": "point nine kilometres,"
  },
  {
   "start": 42.08,
   "end": 43.302,
   "text": "past the edge of"
  },
  {
   "start": 43.302,
   "end": 44.676,
   "text": "the five-psi ring."
  },
  {
   "start": 45.226,
   "end": 47.604,
   "text": "At four and a half kilometres,"
  },
  {
   "start": 47.604,
   "end": 49.666,
   "text": "one pound per square inch."
  },
  {
   "start": 49.666,
   "end": 50.934,
   "text": "Windows shatter,"
  },
  {
   "start": 50.934,
   "end": 53.788,
   "text": "and flying glass becomes the hazard."
  }
 ],
