{
 "subtitles": [
  {
   "start": 0.469,
   "end": 1.89,
   "text": "Why the coast guard,"
  },
  {
   "start": 2.143,
   "end": 3.27,
   "text": "and not the navy?"
  },
  {
   "start": 3.857,
   "end": 5.27,
   "text": "Because of one word."
  },
  {
   "start": 6.223,
   "end": 7.97,
   "text": "Under international law,"
  },
  {
   "start": 8.281,
   "end": 9.68,
   "text": "a blockade of a country's"
  },
  {
   "start": 9.68,
   "end": 11.92,
   "text": "ports by armed forces is"
  },
  {
   "start": 11.92,
   "end": 13.25,
   "text": "an act of aggression."
  },
  {
   "start": 13.68,
   "end": 14.38,
   "text": "It can mark the"
  },
  {
   "start": 14.38,
   "end": 15.65,
   "text": "start of a war."
  },
  {
   "start": 16.142,
   "end": 17.13,
   "text": "A quarantine,"
  },
  {
   "start": 17.329,
   "end": 18.46,
   "text": "run by coast guards"
  },
  {
   "start": 18.46,
   "end": 20.01,
   "text": "and customs officers,"
  },
  {
   "start": 20.277,
   "end": 21.75,
   "text": "is, at least on paper,"
  },
  {
   "start": 22.02,
   "end": 23.07,
   "text": "something less."
  },
  {
   "start": 24.184,
   "end": 26.04,
   "text": "When America surrounded Cuba with"
  },
  {
   "start": 26.04,
   "end": 28.03,
   "text": "warships in nineteen sixty-two,"
  },
  {
   "start": 28.576,
   "end": 30.57,
   "text": "it chose the word quarantine"
  },
  {
   "start": 30.895,
   "end": 32.19,
   "text": "for the same reason."
  },
  {
   "start": 33.129,
   "end": 34.62,
   "text": "China has the largest coast"
  },
  {
   "start": 34.62,
   "end": 35.82,
   "text": "guard in the world,"
  },
  {
   "start": 35.82,
   "end": 36.797,
   "text": "with more than a hundred"
  },
  {
   "start": 36.797,
   "end": 38.75,
   "text": "and fifty ocean-going ships."
  },
  {
   "start": 39.083,
   "end": 40.79,
   "text": "Taiwan's has about ten."
  }
 ],
