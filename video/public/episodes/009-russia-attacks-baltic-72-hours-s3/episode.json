{
 "subtitles": [
  {
   "start": 0.033,
   "end": 1.469,
   "text": "Six weeks earlier,"
  },
  {
   "start": 1.699,
   "end": 3.059,
   "text": "Russia sent NATO states"
  },
  {
   "start": 3.059,
   "end": 4.669,
   "text": "a diplomatic note."
  },
  {
   "start": 4.853,
   "end": 6.259,
   "text": "It said Russia was ready"
  },
  {
   "start": 6.259,
   "end": 8.675,
   "text": "to use its entire arsenal,"
  },
  {
   "start": 8.675,
   "end": 10.549,
   "text": "including nuclear weapons,"
  },
  {
   "start": 10.707,
   "end": 11.719,
   "text": "if NATO tried to"
  },
  {
   "start": 11.719,
   "end": 13.289,
   "text": "cut off Kaliningrad."
  },
  {
   "start": 13.693,
   "end": 16.129,
   "text": "NATO's secretary-general answered:"
  },
  {
   "start": 16.628,
   "end": 18.569,
   "text": "stop the nuclear threats."
  },
  {
   "start": 19.055,
   "end": 20.779,
   "text": "Kaliningrad is Russian land"
  },
  {
   "start": 20.779,
   "end": 22.019,
   "text": "on the Baltic coast,"
  },
  {
   "start": 22.019,
   "end": 23.549,
   "text": "about 1 million people,"
  },
  {
   "start": 23.749,
   "end": 26.129,
   "text": "wedged between Poland and Lithuania."
  },
  {
   "start": 26.622,
   "end": 28.531,
   "text": "It holds the Baltic Fleet"
  },
  {
   "start": 28.531,
   "end": 31.209,
   "text": "and nuclear-capable Iskander missiles."
  }
