{
 "subtitles": [
  {
   "start": 0.717,
   "end": 3.08,
   "text": "And here is the clock."
  },
  {
   "start": 3.625,
   "end": 5.63,
   "text": "Our simulation also assumes"
  },
  {
   "start": 5.63,
   "end": 7.112,
   "text": "the gas terminals,"
  },
  {
   "start": 7.112,
   "end": 9.25,
   "text": "which run on power and controls,"
  },
  {
   "start": 9.25,
   "end": 11.18,
   "text": "stall for lack of both."
  },
  {
   "start": 11.65,
   "end": 14.38,
   "text": "The gas itself is untouched."
  },
  {
   "start": 15.113,
   "end": 17.16,
   "text": "But about 11 days of it"
  },
  {
   "start": 17.16,
   "end": 18.88,
   "text": "is what the island holds,"
  },
  {
   "start": 19.321,
   "end": 20.914,
   "text": "and it cannot burn"
  },
  {
   "start": 20.914,
   "end": 22.36,
   "text": "what it cannot move."
  },
  {
   "start": 22.841,
   "end": 24.834,
   "text": "That is our assumption,"
  },
  {
   "start": 24.834,
   "end": 26.3,
   "text": "not a published finding."
  },
  {
   "start": 26.811,
   "end": 28.353,
   "text": "Day 2 and 3."
  },
  {
   "start": 28.353,
   "end": 30.02,
   "text": "Rotating cuts continue."
  },
  {
   "start": 30.259,
   "end": 31.78,
   "text": "Card payments degrade."
  },
  {
   "start": 32.204,
   "end": 33.18,
   "text": "In 2020,"
  },
  {
   "start": 33.583,
   "end": 34.99,
   "text": "ransomware at the state oil"
  },
  {
   "start": 34.99,
   "end": 37.17,
   "text": "company CPC knocked out card"
  },
  {
   "start": 37.17,
   "end": 39.06,
   "text": "payments at its gas stations."
  },
  {
   "start": 40.068,
   "end": 41.9,
   "text": "Day 4 to 7."
  },
  {
   "start": 42.361,
   "end": 44.3,
   "text": "Power returns in pieces."
  },
  {
   "start": 44.754,
   "end": 45.91,
   "text": "The fabs come back"
  },
  {
   "start": 45.91,
   "end": 47.476,
   "text": "at reduced output,"
  },
  {
   "start": 47.476,
   "end": 48.49,
   "text": "not zero."
  }
