{
 "subtitles": [
  {
   "start": 0.0,
   "end": 2.286,
   "text": "4:38 in the morning,"
  },
  {
   "start": 2.286,
   "end": 3.186,
   "text": "central Iran:"
  },
  {
   "start": 3.186,
   "end": 4.848,
   "text": "a nuclear warhead bursts"
  },
  {
   "start": 4.848,
   "end": 5.818,
   "text": "on a mountain."
  },
  {
   "start": 6.368,
   "end": 7.751,
   "text": "This is a simulation,"
  },
  {
   "start": 7.751,
   "end": 9.331,
   "text": "and it has not happened."
  },
  {
   "start": 9.881,
   "end": 11.545,
   "text": "8 minutes earlier,"
  },
  {
   "start": 11.545,
   "end": 13.511,
   "text": "a Jericho missile leaves a"
  },
  {
   "start": 13.511,
   "end": 15.477,
   "text": "battery in central Israel."
  },
  {
   "start": 15.477,
   "end": 16.838,
   "text": "It has one target:"
  },
  {
   "start": 16.838,
   "end": 18.275,
   "text": "a mountain in Iran."
  },
  {
   "start": 18.825,
   "end": 20.147,
   "text": "4 days before,"
  },
  {
   "start": 20.147,
   "end": 22.247,
   "text": "that mountain hosted Iran's"
  },
  {
   "start": 22.247,
   "end": 23.724,
   "text": "first nuclear test."
  },
  {
   "start": 23.724,
   "end": 26.057,
   "text": "Since then an Israeli air raid"
  },
  {
   "start": 26.057,
   "end": 28.312,
   "text": "has hit its tunnel entrances,"
  },
  {
   "start": 28.312,
   "end": 30.178,
   "text": "and Iran has fired back."
  },
  {
   "start": 30.178,
   "end": 31.578,
   "text": "The work under the"
  },
  {
   "start": 31.578,
   "end": 33.211,
   "text": "rock has not stopped."
  },
  {
   "start": 33.761,
   "end": 36.062,
   "text": "One question hangs over the map."
  },
  {
   "start": 36.062,
   "end": 37.5,
   "text": "Did the weapon reach"
  },
  {
   "start": 37.5,
   "end": 39.153,
   "text": "what was buried inside?"
  },
  {
   "start": 39.153,
   "end": 40.807,
   "text": "This film answers it as"
  },
  {
   "start": 40.807,
   "end": 42.604,
   "text": "far as published data go."
  }
 ],
