{
 "subtitles": [
  {
   "start": 0.098,
   "end": 2.341,
   "text": "Its target is not a city."
  },
  {
   "start": 2.341,
   "end": 4.163,
   "text": "It is the American carrier"
  },
  {
   "start": 4.163,
   "end": 6.063,
   "text": "group in the Philippine Sea,"
  },
  {
   "start": 6.063,
   "end": 7.284,
   "text": "about six hundred and fifty"
  },
  {
   "start": 7.284,
   "end": 9.393,
   "text": "kilometres east of Taiwan."
  },
  {
   "start": 10.218,
   "end": 11.933,
   "text": "Seven minutes later,"
  },
  {
   "start": 12.107,
   "end": 13.923,
   "text": "the warhead detonates a few"
  },
  {
   "start": 13.923,
   "end": 15.913,
   "text": "hundred metres above the sea."
  },
  {
   "start": 16.502,
   "end": 17.873,
   "text": "Ten kilotons:"
  },
  {
   "start": 18.192,
   "end": 19.383,
   "text": "the top of the Pentagon's"
  },
  {
   "start": 19.383,
   "end": 21.893,
   "text": "estimate for China's smallest warheads,"
  },
  {
   "start": 22.182,
   "end": 23.993,
   "text": "and about half of Nagasaki."
  },
  {
   "start": 25.084,
   "end": 26.423,
   "text": "The fireball is about"
  },
  {
   "start": 26.423,
   "end": 28.313,
   "text": "three hundred metres across."
  },
  {
   "start": 29.215,
   "end": 29.963,
   "text": "Within about one and"
  },
  {
   "start": 29.963,
   "end": 31.113,
   "text": "a half kilometres,"
  },
  {
   "start": 31.519,
   "end": 32.683,
   "text": "a blast like this would"
  },
  {
   "start": 32.683,
   "end": 35.113,
   "text": "flatten most buildings on land."
  },
  {
   "start": 35.567,
   "end": 36.453,
   "text": "At sea,"
  },
  {
   "start": 36.629,
   "end": 38.573,
   "text": "that ring holds the carrier."
  },
  {
   "start": 38.956,
   "end": 41.093,
   "text": "Within one point six kilometres,"
  },
  {
   "start": 41.413,
   "end": 42.923,
   "text": "the flash alone burns"
  },
  {
   "start": 42.923,
   "end": 44.653,
   "text": "anyone out on deck."
  },
  {
   "start": 45.779,
   "end": 47.543,
   "text": "Out to about four kilometres,"
  },
  {
   "start": 47.543,
   "end": 49.673,
   "text": "it would shatter windows on land."
  },
  {
   "start": 50.112,
   "end": 52.113,
   "text": "The ships further out are shaken,"
  },
  {
   "start": 52.358,
   "end": 53.733,
   "text": "and still afloat."
  },
  {
   "start": 54.744,
   "end": 55.523,
   "text": "For the first time"
  },
  {
   "start": 55.523,
   "end": 57.216,
   "text": "in eighty-one years,"
  },
  {
   "start": 57.216,
   "end": 58.283,
   "text": "a nuclear weapon has"
  },
  {
   "start": 58.283,
   "end": 59.693,
   "text": "been used in war."
  }
 ],
