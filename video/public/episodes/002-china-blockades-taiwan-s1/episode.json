{
 "subtitles": [
  {
   "start": 0.37,
   "end": 2.683,
   "text": "Taiwan imports about ninety-seven"
  },
  {
   "start": 2.683,
   "end": 4.375,
   "text": "percent of its energy,"
  },
  {
   "start": 4.612,
   "end": 5.525,
   "text": "and almost all of"
  },
  {
   "start": 5.525,
   "end": 7.095,
   "text": "it arrives by sea."
  },
  {
   "start": 7.658,
   "end": 9.505,
   "text": "Nearly half of its electricity"
  },
  {
   "start": 9.505,
   "end": 11.615,
   "text": "comes from natural gas,"
  },
  {
   "start": 11.903,
   "end": 13.425,
   "text": "almost all of it shipped in"
  },
  {
   "start": 13.425,
   "end": 15.555,
   "text": "as liquid through three terminals:"
  },
  {
   "start": 15.803,
   "end": 17.505,
   "text": "one in Kaohsiung,"
  },
  {
   "start": 17.505,
   "end": 19.055,
   "text": "one in Taichung,"
  },
  {
   "start": 19.222,
   "end": 20.815,
   "text": "one near Taipei."
  },
  {
   "start": 21.346,
   "end": 23.345,
   "text": "Its last nuclear reactor shut"
  },
  {
   "start": 23.345,
   "end": 25.135,
   "text": "down in May twenty twenty-five."
  },
  {
   "start": 26.124,
   "end": 27.065,
   "text": "By law,"
  },
  {
   "start": 27.065,
   "end": 28.865,
   "text": "Taiwan keeps about eleven days"
  },
  {
   "start": 28.865,
   "end": 30.515,
   "text": "of gas in storage."
  },
  {
   "start": 30.848,
   "end": 33.405,
   "text": "Coal, about forty days. Oil,"
  },
  {
   "start": 33.405,
   "end": 34.995,
   "text": "about four and a half months."
  },
  {
   "start": 35.501,
   "end": 35.505,
   "text": "It grows only about thirty percent"
  },
  {
   "start": 37.285,
   "end": 35.505,
   "text": "of the calories its people eat."
  }
