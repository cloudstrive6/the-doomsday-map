{
 "subtitles": [
  {
   "start": 0.0,
   "end": 2.59,
   "text": "11:26, Batan Island:"
  },
  {
   "start": 2.993,
   "end": 4.5,
   "text": "the first nuclear weapon used"
  },
  {
   "start": 4.5,
   "end": 6.65,
   "text": "in war since Nagasaki."
  },
  {
   "start": 7.098,
   "end": 8.55,
   "text": "This is a simulation,"
  },
  {
   "start": 8.814,
   "end": 10.31,
   "text": "and it has not happened."
  },
  {
   "start": 11.014,
   "end": 12.65,
   "text": "6 minutes earlier,"
  },
  {
   "start": 12.925,
   "end": 14.52,
   "text": "a single missile leaves a"
  },
  {
   "start": 14.52,
   "end": 16.49,
   "text": "launcher in southern China."
  },
  {
   "start": 16.801,
   "end": 18.69,
   "text": "It is a DF-26."
  },
  {
   "start": 19.356,
   "end": 20.06,
   "text": "It is aimed at a"
  },
  {
   "start": 20.06,
   "end": 21.68,
   "text": "small airport on an island"
  },
  {
   "start": 21.68,
   "end": 23.6,
   "text": "in the Luzon Strait,"
  },
  {
   "start": 23.6,
   "end": 24.5,
   "text": "where a battery of"
  },
  {
   "start": 24.5,
   "end": 26.31,
   "text": "American launchers sits."
  },
  {
   "start": 27.466,
   "end": 28.26,
   "text": "On the sixth day"
  },
  {
   "start": 28.26,
   "end": 29.496,
   "text": "of this war,"
  },
  {
   "start": 29.496,
   "end": 31.06,
   "text": "the question is which"
  },
  {
   "start": 31.06,
   "end": 33.17,
   "text": "side runs short first,"
  },
  {
   "start": 33.322,
   "end": 34.55,
   "text": "and whether it matters."
  }
