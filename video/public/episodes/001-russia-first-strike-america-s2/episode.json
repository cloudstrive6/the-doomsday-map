{
 "subtitles": [
  {
   "start": 0.0,
   "end": 1.828,
   "text": "Take that one warhead."
  },
  {
   "start": 1.828,
   "end": 3.74,
   "text": "Eight hundred kilotons,"
  },
  {
   "start": 3.74,
   "end": 4.986,
   "text": "a ground burst,"
  },
  {
   "start": 4.986,
   "end": 7.397,
   "text": "because the target is buried."
  },
  {
   "start": 7.397,
   "end": 9.059,
   "text": "The fireball is more"
  },
  {
   "start": 9.059,
   "end": 11.303,
   "text": "than two kilometres across."
  },
  {
   "start": 11.303,
   "end": 13.962,
   "text": "Everything inside a kilometre of"
  },
  {
   "start": 13.962,
   "end": 16.123,
   "text": "the runway is simply gone."
  },
  {
   "start": 16.673,
   "end": 18.031,
   "text": "To five kilometres,"
  },
  {
   "start": 18.031,
   "end": 20.103,
   "text": "most buildings are destroyed."
  },
  {
   "start": 20.103,
   "end": 22.247,
   "text": "That is the whole of Bellevue,"
  },
  {
   "start": 22.247,
   "end": 24.534,
   "text": "a city of sixty thousand people,"
  },
  {
   "start": 24.534,
   "end": 25.963,
   "text": "and the base itself."
  },
  {
   "start": 26.513,
   "end": 28.343,
   "text": "To nearly ten kilometres,"
  },
  {
   "start": 28.343,
   "end": 31.416,
   "text": "anyone outdoors suffers third-degree burns"
  },
  {
   "start": 31.416,
   "end": 32.953,
   "text": "from the flash alone."
  },
  {
   "start": 32.953,
   "end": 34.783,
   "text": "That reaches the southern"
  },
  {
   "start": 34.783,
   "end": 36.027,
   "text": "suburbs of Omaha."
  },
  {
   "start": 36.577,
   "end": 38.612,
   "text": "To fourteen kilometres,"
  },
  {
   "start": 38.612,
   "end": 40.028,
   "text": "windows blow in."
  },
  {
   "start": 40.028,
   "end": 42.24,
   "text": "Downtown Omaha is fifteen"
  },
  {
   "start": 42.24,
   "end": 44.629,
   "text": "kilometres from the runway."
  },
  {
   "start": 44.629,
   "end": 47.195,
   "text": "It keeps its windows, barely,"
  },
  {
   "start": 47.195,
   "end": 48.965,
   "text": "and loses its power,"
  },
  {
   "start": 48.965,
   "end": 52.238,
   "text": "its water pressure and its hospitals'"
  },
  {
   "start": 52.238,
   "end": 54.716,
   "text": "capacity in the same minute."
  }
 ],
