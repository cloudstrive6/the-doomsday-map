  },
  {
   "start": 6.645,
   "end": 8.889,
   "text": "That is 31 square kilometres."
  },
  {
   "start": 9.575,
   "end": 10.124,
   "text": "The Capitol,"
  },
  {
   "start": 10.124,
   "end": 11.519,
   "text": "two and a half kilometres"
  },
  {
   "start": 11.519,
   "end": 12.908,
   "text": "from the White House,"
  },
  {
   "start": 12.908,
   "end": 15.439,
   "text": "is inside the ring. The Pentagon,"
  },
  {
   "start": 15.439,
   "end": 17.789,
   "text": "3.3 km away,"
  },
  {
   "start": 18.006,
   "end": 19.389,
   "text": "sits at its edge."
  },
  {
   "start": 19.925,
   "end": 21.339,
   "text": "The engine's uncertainty is"
  },
