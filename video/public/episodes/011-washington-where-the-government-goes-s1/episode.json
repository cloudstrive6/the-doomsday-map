  },
  {
   "start": 22.877,
   "end": 23.559,
   "text": "so at the edge"
  },
  {
   "start": 23.559,
   "end": 24.909,
   "text": "never means safe."
  },
  {
   "start": 25.937,
   "end": 27.619,
   "text": "The flash burns bare skin"
