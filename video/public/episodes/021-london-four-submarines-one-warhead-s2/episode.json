{
 "subtitles": [
  {
   "start": 0.405,
   "end": 2.171,
   "text": "At 3.1 km,"
  },
  {
   "start": 2.491,
   "end": 3.641,
   "text": "it falls to five"
  },
  {
   "start": 3.641,
   "end": 5.353,
   "text": "pounds per square inch."
  },
  {
   "start": 5.353,
   "end": 6.851,
   "text": "Most houses collapse."
  },
  {
   "start": 7.103,
   "end": 10.211,
   "text": "That circle covers 31 square kilometres,"
  },
  {
   "start": 10.487,
   "end": 12.731,
   "text": "about 2% of Greater London."
  },
  {
   "start": 13.712,
   "end": 15.671,
   "text": "At 4.2 km,"
  },
  {
   "start": 16.021,
   "end": 17.641,
   "text": "bare skin takes third-degree"
  },
  {
   "start": 17.641,
   "end": 19.171,
   "text": "burns from the flash."
  },
  {
   "start": 20.08,
   "end": 21.921,
   "text": "At eight and a half kilometres,"
  },
  {
   "start": 21.921,
   "end": 22.961,
   "text": "the blast is one"
  },
  {
   "start": 22.961,
   "end": 24.783,
   "text": "pound per square inch."
  },
  {
   "start": 24.783,
   "end": 25.921,
   "text": "Windows shatter,"
  },
  {
   "start": 25.921,
   "end": 27.941,
   "text": "and flying glass injures people"
  },
  {
   "start": 27.941,
   "end": 29.391,
   "text": "far from the fireball."
  },
  {
   "start": 29.936,
   "end": 31.981,
   "text": "Because this is an airburst,"
  },
  {
   "start": 31.981,
   "end": 33.771,
   "text": "local fallout is small."
  },
  {
   "start": 34.174,
   "end": 35.521,
   "text": "The smoke and dust of a"
  },
  {
   "start": 35.521,
   "end": 37.851,
   "text": "burning city are not modelled here."
  },
  {
   "start": 38.131,
   "end": 38.981,
   "text": "On average about"
  },
  {
   "start": 38.981,
   "end": 40.981,
   "text": "5,800 people live"
  },
  {
   "start": 40.981,
   "end": 43.581,
   "text": "on each square kilometre of Greater London,"
  },
  {
   "start": 43.581,
   "end": 44.601,
   "text": "and the morning rush"
  },
  {
   "start": 44.601,
   "end": 45.821,
   "text": "moves them around."
  },
  {
   "start": 45.821,
   "end": 46.941,
   "text": "We still do not count"
  },
  {
   "start": 46.941,
   "end": 48.661,
   "text": "who is inside these rings."
  }
 ],
