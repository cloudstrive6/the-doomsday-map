{
 "subtitles": [
  {
   "start": 0.271,
   "end": 1.31,
   "text": "It detonates in the"
  },
  {
   "start": 1.31,
   "end": 3.35,
   "text": "air above downtown Seattle."
  },
  {
   "start": 3.35,
   "end": 5.64,
   "text": "Two hundred and fifty kilotons."
  },
  {
   "start": 7.023,
   "end": 8.617,
   "text": "The fireball is five hundred"
  },
  {
   "start": 8.617,
   "end": 10.38,
   "text": "and fifty metres in radius."
  },
  {
   "start": 10.843,
   "end": 12.92,
   "text": "Everything inside it is vapour."
  },
  {
   "start": 14.125,
   "end": 15.199,
   "text": "Out to eight hundred"
  },
  {
   "start": 15.199,
   "end": 16.52,
   "text": "and seventy metres,"
  },
  {
   "start": 16.728,
   "end": 18.37,
   "text": "the blast adds twenty pounds"
  },
  {
   "start": 18.37,
   "end": 20.14,
   "text": "per square inch of pressure."
  },
  {
   "start": 20.421,
   "end": 22.6,
   "text": "Even strong buildings are destroyed."
  },
  {
   "start": 23.649,
   "end": 26.21,
   "text": "Out to four point three kilometres,"
  },
  {
   "start": 26.21,
   "end": 28.36,
   "text": "five pounds per square inch."
  },
  {
   "start": 28.795,
   "end": 30.24,
   "text": "Most houses collapse."
  },
  {
   "start": 30.68,
   "end": 31.93,
   "text": "That ring covers about"
  },
  {
   "start": 31.93,
   "end": 34.02,
   "text": "fifty-seven square kilometres."
  },
  {
   "start": 34.918,
   "end": 36.25,
   "text": "Out to six kilometres,"
  },
  {
   "start": 36.25,
   "end": 38.73,
   "text": "the flash itself causes third-degree"
  },
  {
   "start": 38.73,
   "end": 40.62,
   "text": "burns on bare skin."
  },
  {
   "start": 41.706,
   "end": 42.69,
   "text": "And out to eleven"
  },
  {
   "start": 42.69,
   "end": 43.73,
   "text": "and a half kilometres,"
  },
  {
   "start": 43.73,
   "end": 46.04,
   "text": "one pound per square inch."
  },
  {
   "start": 46.45,
   "end": 48.02,
   "text": "Windows shatter,"
  },
  {
   "start": 48.308,
   "end": 50.18,
   "text": "and the glass becomes a weapon."
  }
 ],
