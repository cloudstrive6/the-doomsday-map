{
 "subtitles": [
  {
   "start": 7.607,
   "end": 9.136,
   "text": "For a moment the sea"
  },
  {
   "start": 9.136,
   "end": 10.512,
   "text": "is lit from above."
  },
  {
   "start": 10.512,
   "end": 12.729,
   "text": "The destroyers closest to the"
  },
  {
   "start": 12.729,
   "end": 15.023,
   "text": "centre are inside the fireball"
  },
  {
   "start": 15.023,
   "end": 16.781,
   "text": "and the heaviest rings,"
  },
  {
   "start": 16.781,
   "end": 18.769,
   "text": "and in our simulation they"
  },
  {
   "start": 18.769,
   "end": 20.375,
   "text": "are lost or crippled."
  },
  {
   "start": 20.375,
   "end": 21.98,
   "text": "The ships at the edge"
  },
  {
   "start": 21.98,
   "end": 24.121,
   "text": "are shaken and still moving."
  },
  {
   "start": 24.671,
   "end": 26.14,
   "text": "The first thing aboard"
  },
  {
   "start": 26.14,
   "end": 27.542,
   "text": "the carrier is light."
  },
  {
   "start": 27.542,
   "end": 28.143,
   "text": "At night,"
  },
  {
   "start": 28.143,
   "end": 30.146,
   "text": "the whole horizon turns white,"
  },
  {
   "start": 30.146,
   "end": 31.816,
   "text": "and the sea itself glows."
  },
  {
   "start": 31.816,
   "end": 34.019,
   "text": "The blast wave arrives afterward,"
  },
  {
   "start": 34.019,
   "end": 36.49,
   "text": "because it travels slower than light."
  }
 ],
