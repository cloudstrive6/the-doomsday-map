   "text": "Day 3."
  },
  {
   "start": 1.687,
   "end": 3.981,
   "text": "A Bastion battery on Kunashir fires"
  },
  {
   "start": 3.981,
   "end": 6.281,
   "text": "one Oniks missile at a Japanese"
  },
  {
   "start": 6.281,
   "end": 7.931,
   "text": "destroyer in the strait."
  },
  {
   "start": 8.166,
   "end": 10.711,
   "text": "The target is 54 km away."
  },
  {
   "start": 10.895,
   "end": 12.971,
   "text": "The missile takes under 4 minutes."
  },
  {
   "start": 13.451,
   "end": 14.881,
   "text": "Whether the ship survives,"
  },
  {
   "start": 14.881,
   "end": 16.031,
   "text": "we do not say."
  },
  {
   "start": 16.373,
   "end": 18.431,
   "text": "Nothing about its crew is simulated."
  },
  {
   "start": 20.108,
   "end": 24.091,
   "text": "Day 4. Nothing is fired."
  },
  {
   "start": 24.859,
   "end": 27.391,
   "text": "Both governments say, in public,"
  },
  {
   "start": 27.774,
   "end": 30.311,
   "text": "that they want no wider war."
  },
  {
   "start": 30.697,
   "end": 32.271,
   "text": "The calm is thin:"
  },
  {
   "start": 32.579,
   "end": 34.301,
   "text": "the same two phones that could"
  },
  {
   "start": 34.301,
   "end": 36.851,
   "text": "have rung are still silent."
  }
