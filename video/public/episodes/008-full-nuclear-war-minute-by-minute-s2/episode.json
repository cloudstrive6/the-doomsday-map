{
 "subtitles": [
  {
   "start": 0.002,
   "end": 1.306,
   "text": "Minute 17."
  },
  {
   "start": 1.832,
   "end": 2.996,
   "text": "Six warheads go to"
  },
  {
   "start": 2.996,
   "end": 4.746,
   "text": "Washington and the Pentagon."
  },
  {
   "start": 5.3,
   "end": 7.368,
   "text": "The base at Kings Bay, Georgia,"
  },
  {
   "start": 7.368,
   "end": 9.816,
   "text": "home to six Ohio-class submarines,"
  },
  {
   "start": 9.816,
   "end": 11.386,
   "text": "follows at minute 19."
  },
  {
   "start": 11.831,
   "end": 14.326,
   "text": "Minutes 25 to 28."
  },
  {
   "start": 14.904,
   "end": 17.646,
   "text": "The Northern Fleet base near Murmansk,"
  },
  {
   "start": 17.803,
   "end": 20.6,
   "text": "the Pacific Fleet base at Vilyuchinsk,"
  },
  {
   "start": 20.6,
   "end": 23.666,
   "text": "Plesetsk, Moscow's command centres."
  },
  {
   "start": 24.564,
   "end": 27.426,
   "text": "Minutes 29 to 36."
  },
  {
   "start": 28.305,
   "end": 30.796,
   "text": "The Russian land missiles arrive after"
  },
  {
   "start": 30.796,
   "end": 33.316,
   "text": "about 30 minutes in flight."
  },
  {
   "start": 34.34,
   "end": 33.316,
   "text": "Minuteman is the force a"
  },
  {
   "start": 36.336,
   "end": 33.316,
   "text": "first strike tries to catch"
  },
  {
   "start": 38.076,
   "end": 33.316,
   "text": "before it leaves,"
  },
  {
   "start": 39.612,
   "end": 33.316,
   "text": "which is why the"
  },
  {
   "start": 40.356,
   "end": 33.316,
   "text": "silo fields come early."
  },
  {
   "start": 42.817,
   "end": 33.316,
   "text": "The three silo-field strikes"
  },
  {
   "start": 44.676,
   "end": 33.316,
   "text": "carry 60 warheads each,"
  },
  {
   "start": 47.4,
   "end": 33.316,
   "text": "of roughly 100"
  },
  {
   "start": 48.456,
   "end": 33.316,
   "text": "to 300 kilotons."
  },
  {
   "start": 51.053,
   "end": 33.316,
   "text": "They hit Minot,"
  },
  {
   "start": 52.459,
   "end": 33.316,
   "text": "Malmstrom and Warren, Cheyenne Mountain,"
  },
  {
   "start": 55.796,
   "end": 33.316,
   "text": "Offutt and the bomber bases."
  },
  {
   "start": 58.192,
   "end": 33.316,
   "text": "The strike on Offutt"
  },
  {
   "start": 59.356,
   "end": 33.316,
   "text": "uses larger warheads,"
  },
  {
   "start": 61.606,
   "end": 33.316,
   "text": "up to about"
  },
  {
   "start": 62.216,
   "end": 33.316,
   "text": "750 kilotons."
  },
  {
   "start": 64.527,
   "end": 33.316,
   "text": "By now the American land missiles"
  },
  {
   "start": 66.676,
   "end": 33.316,
   "text": "are already in the air."
  },
  {
   "start": 68.869,
   "end": 33.316,
   "text": "The warheads land on silos"
  },
  {
   "start": 70.716,
   "end": 33.316,
   "text": "that are mostly empty,"
  },
  {
   "start": 72.669,
   "end": 33.316,
   "text": "and they still land."
  }
