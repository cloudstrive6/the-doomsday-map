{
 "subtitles": [
  {
   "start": 0.017,
   "end": 1.202,
   "text": "Two points stay lit"
  },
  {
   "start": 1.202,
   "end": 2.834,
   "text": "outside the rings:"
  },
  {
   "start": 2.834,
   "end": 5.362,
   "text": "Mount Weather and Raven Rock."
  },
  {
   "start": 5.362,
   "end": 6.873,
   "text": "Whoever reached them,"
  },
  {
   "start": 6.873,
   "end": 8.462,
   "text": "the law already lists"
  },
  {
   "start": 8.462,
   "end": 10.012,
   "text": "who acts next:"
  },
  {
   "start": 10.17,
   "end": 12.632,
   "text": "after the president and vice president,"
  },
  {
   "start": 12.794,
   "end": 14.232,
   "text": "the Speaker of the House,"
  },
  {
   "start": 14.44,
   "end": 15.822,
   "text": "then the president pro"
  },
  {
   "start": 15.822,
   "end": 17.752,
   "text": "tempore of the Senate,"
  },
  {
   "start": 18.081,
   "end": 20.072,
   "text": "then the cabinet by office,"
  },
  {
   "start": 20.26,
   "end": 21.952,
   "text": "17 in all."
  },
  {
   "start": 22.249,
   "end": 23.786,
   "text": "Who holds each office"
  },
  {
   "start": 23.786,
   "end": 24.992,
   "text": "is not modelled."
  },
  {
   "start": 25.47,
   "end": 27.232,
   "text": "The hard gap is Congress."
  },
  {
   "start": 27.751,
   "end": 28.902,
   "text": "The House can refill its"
  },
  {
   "start": 28.902,
   "end": 31.792,
   "text": "seats only by special election,"
  },
  {
   "start": 32.12,
   "end": 33.642,
   "text": "which takes states about"
  },
  {
   "start": 33.642,
   "end": 35.412,
   "text": "four months on average."
  },
  {
   "start": 35.871,
   "end": 37.162,
   "text": "Governors can fill Senate"
  },
  {
   "start": 37.162,
   "end": 38.651,
   "text": "seats within days."
  },
  {
   "start": 38.651,
   "end": 40.022,
   "text": "Whether a quorum counts the"
  },
  {
   "start": 40.022,
   "end": 41.592,
   "text": "living or the whole chamber"
  },
  {
   "start": 41.787,
   "end": 43.852,
   "text": "is a question scholars dispute."
  },
  {
   "start": 44.312,
   "end": 45.732,
   "text": "In 2003,"
  },
  {
   "start": 46.013,
   "end": 48.232,
   "text": "a commission imagined a nuclear attack"
  },
  {
   "start": 48.395,
   "end": 50.692,
   "text": "in which Congress had been annihilated,"
  },
  {
   "start": 50.692,
   "end": 53.012,
   "text": "and urged a constitutional amendment."
  }
