{
 "subtitles": [
  {
   "start": 0.0,
   "end": 3.37,
   "text": "3:43 in the morning, Lithuania:"
  },
  {
   "start": 3.571,
   "end": 5.2,
   "text": "the first nuclear weapon used"
  },
  {
   "start": 5.2,
   "end": 7.15,
   "text": "in war since Nagasaki."
  },
  {
   "start": 7.725,
   "end": 9.26,
   "text": "This is a simulation"
  },
  {
   "start": 9.26,
   "end": 11.39,
   "text": "built from published numbers,"
  },
  {
   "start": 11.752,
   "end": 13.11,
   "text": "and it has not happened."
  },
  {
   "start": 13.786,
   "end": 15.178,
   "text": "3 minutes earlier,"
  },
  {
   "start": 15.178,
   "end": 16.485,
   "text": "a radar in the Baltic"
  },
  {
   "start": 16.485,
   "end": 18.1,
   "text": "picks up a ballistic missile"
  },
  {
   "start": 18.1,
   "end": 20.17,
   "text": "climbing out of Kaliningrad."
  },
  {
   "start": 20.48,
   "end": 21.849,
   "text": "It is one missile,"
  },
  {
   "start": 21.849,
   "end": 23.55,
   "text": "aimed at one air base."
  },
  {
   "start": 23.868,
   "end": 25.0,
   "text": "Nobody on the ground can"
  },
  {
   "start": 25.0,
   "end": 27.02,
   "text": "tell whether the warhead is"
  },
  {
   "start": 27.02,
   "end": 28.81,
   "text": "conventional or nuclear."
  },
  {
   "start": 29.818,
   "end": 31.0,
   "text": "It is the sixty-first"
  },
  {
   "start": 31.0,
   "end": 31.95,
   "text": "hour of the war."
  },
  {
   "start": 32.41,
   "end": 31.95,
   "text": "Why would Moscow fire it,"
  },
  {
   "start": 34.631,
   "end": 31.95,
   "text": "and what does the world"
  },
  {
   "start": 35.6,
   "end": 31.95,
   "text": "do in the hour after?"
  }
