{
 "subtitles": [
  {
   "start": 0.0,
   "end": 2.175,
   "text": "A rescue and medical effort"
  },
  {
   "start": 2.175,
   "end": 4.27,
   "text": "begins from the ships that"
  },
  {
   "start": 4.27,
   "end": 5.559,
   "text": "can still steam."
  },
  {
   "start": 5.559,
   "end": 7.412,
   "text": "We do not count anyone,"
  },
  {
   "start": 7.412,
   "end": 8.782,
   "text": "and we do not say"
  },
  {
   "start": 8.782,
   "end": 10.635,
   "text": "how many ships that is."
  },
  {
   "start": 11.185,
   "end": 12.757,
   "text": "The carrier turns on"
  },
  {
   "start": 12.757,
   "end": 15.115,
   "text": "its counter-measure wash-down,"
  },
  {
   "start": 15.115,
   "end": 17.394,
   "text": "the pipes that spray seawater"
  },
  {
   "start": 17.394,
   "end": 18.887,
   "text": "over deck and hull."
  },
  {
   "start": 18.887,
   "end": 20.538,
   "text": "The Navy built it for"
  },
  {
   "start": 20.538,
   "end": 22.974,
   "text": "fires and radiological threats,"
  },
  {
   "start": 22.974,
   "end": 24.782,
   "text": "and nobody knows how it"
  },
  {
   "start": 24.782,
   "end": 26.747,
   "text": "would work after a burst."
  },
  {
   "start": 27.297,
   "end": 29.484,
   "text": "The fallout map is nearly empty."
  },
  {
   "start": 29.484,
   "end": 31.398,
   "text": "The model gives little local"
  },
  {
   "start": 31.398,
   "end": 33.106,
   "text": "fallout for an air burst."
  },
  {
   "start": 33.106,
   "end": 33.653,
   "text": "At Able,"
  },
  {
   "start": 33.653,
   "end": 34.952,
   "text": "most ships could be"
  },
  {
   "start": 34.952,
   "end": 36.524,
   "text": "reboarded within a day,"
  },
  {
   "start": 36.524,
   "end": 37.48,
   "text": "and at Wigwam,"
  },
  {
   "start": 37.48,
   "end": 38.506,
   "text": "by one account,"
  },
  {
   "start": 38.506,
   "end": 40.214,
   "text": "the ships downwind stayed"
  },
  {
   "start": 40.214,
   "end": 41.65,
   "text": "under the dose limit."
  },
  {
   "start": 41.65,
   "end": 43.29,
   "text": "Those are two histories,"
  },
  {
   "start": 43.29,
   "end": 44.315,
   "text": "not a forecast."
  }
 ],
