{
 "subtitles": [
  {
   "start": 0.55,
   "end": 2.374,
   "text": "A rescue and medical effort"
  },
  {
   "start": 2.374,
   "end": 3.994,
   "text": "begins from the ships that"
  },
  {
   "start": 3.994,
   "end": 5.124,
   "text": "can still steam."
  },
  {
   "start": 5.916,
   "end": 7.584,
   "text": "We do not count anyone,"
  },
  {
   "start": 7.866,
   "end": 8.854,
   "text": "and we do not say"
  },
  {
   "start": 8.854,
   "end": 10.644,
   "text": "how many ships that is."
  },
  {
   "start": 11.605,
   "end": 12.874,
   "text": "The carrier turns on"
  },
  {
   "start": 12.874,
   "end": 15.096,
   "text": "its counter-measure wash-down,"
  },
  {
   "start": 15.096,
   "end": 16.854,
   "text": "the pipes that spray seawater"
  },
  {
   "start": 16.854,
   "end": 18.444,
   "text": "over deck and hull."
  },
  {
   "start": 19.406,
   "end": 20.714,
   "text": "The Navy built it for"
  },
  {
   "start": 20.714,
   "end": 23.404,
   "text": "fires and radiological threats,"
  },
  {
   "start": 23.762,
   "end": 25.054,
   "text": "and nobody knows how it"
  },
  {
   "start": 25.054,
   "end": 26.784,
   "text": "would work after a burst."
  },
  {
   "start": 27.298,
   "end": 29.184,
   "text": "The fallout map is nearly empty."
  },
  {
   "start": 29.442,
   "end": 30.694,
   "text": "The model gives little local"
  },
  {
   "start": 30.694,
   "end": 32.324,
   "text": "fallout for an air burst."
  },
  {
   "start": 32.652,
   "end": 33.538,
   "text": "At Able,"
  },
  {
   "start": 33.538,
   "end": 34.374,
   "text": "most ships could be"
  },
  {
   "start": 34.374,
   "end": 36.044,
   "text": "reboarded within a day,"
  },
  {
   "start": 36.282,
   "end": 37.464,
   "text": "and at Wigwam,"
  },
  {
   "start": 37.464,
   "end": 38.539,
   "text": "by one account,"
  },
  {
   "start": 38.539,
   "end": 39.834,
   "text": "the ships downwind stayed"
  },
  {
   "start": 39.834,
   "end": 41.244,
   "text": "under the dose limit."
  },
  {
   "start": 41.724,
   "end": 42.964,
   "text": "Those are two histories,"
  },
  {
   "start": 43.259,
   "end": 44.374,
   "text": "not a forecast."
  }
 ],
