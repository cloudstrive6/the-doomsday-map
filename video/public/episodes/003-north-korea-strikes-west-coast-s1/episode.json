{
 "subtitles": [
  {
   "start": 0.029,
   "end": 1.42,
   "text": "America's defence of its own"
  },
  {
   "start": 1.42,
   "end": 3.06,
   "text": "territory is a system called"
  },
  {
   "start": 3.06,
   "end": 5.27,
   "text": "Ground-based Midcourse Defense."
  },
  {
   "start": 5.613,
   "end": 7.69,
   "text": "It has forty-four interceptors."
  },
  {
   "start": 7.89,
   "end": 9.5,
   "text": "Forty are at Fort Greely,"
  },
  {
   "start": 9.5,
   "end": 11.76,
   "text": "in Alaska. Four are at Vandenberg,"
  },
  {
   "start": 11.76,
   "end": 12.89,
   "text": "in California."
  },
  {
   "start": 13.342,
   "end": 14.7,
   "text": "An interceptor does not"
  },
  {
   "start": 14.7,
   "end": 16.37,
   "text": "explode near a missile."
  },
  {
   "start": 16.718,
   "end": 18.12,
   "text": "It collides with the"
  },
  {
   "start": 18.12,
   "end": 19.95,
   "text": "warhead in space,"
  },
  {
   "start": 20.134,
   "end": 21.63,
   "text": "in the middle of its flight."
  },
  {
   "start": 22.382,
   "end": 23.786,
   "text": "In scripted tests,"
  },
  {
   "start": 23.786,
   "end": 26.56,
   "text": "the Arms Control Association counts twelve"
  },
  {
   "start": 26.56,
   "end": 29.59,
   "text": "successful intercepts in twenty-one attempts."
  },
  {
   "start": 29.896,
   "end": 31.91,
   "text": "Roughly half to sixty percent."
  },
  {
   "start": 32.703,
   "end": 34.32,
   "text": "In twenty nineteen,"
  },
  {
   "start": 34.32,
   "end": 36.72,
   "text": "the system fired two interceptors at"
  },
  {
   "start": 36.72,
   "end": 38.83,
   "text": "one target for the first time."
  },
  {
   "start": 39.06,
   "end": 40.07,
   "text": "Both worked."
  },
  {
   "start": 41.059,
   "end": 42.6,
   "text": "A real engagement would likely"
  },
  {
   "start": 42.6,
   "end": 44.48,
   "text": "use more than one interceptor"
  },
  {
   "start": 44.48,
   "end": 45.99,
   "text": "for each warhead,"
  },
  {
   "start": 46.312,
   "end": 48.34,
   "text": "so forty-four interceptors do not"
  },
  {
   "start": 48.34,
   "end": 50.57,
   "text": "mean forty-four missiles stopped."
  },
  {
   "start": 51.054,
   "end": 51.98,
   "text": "Critics point out that"
  },
  {
   "start": 51.98,
   "end": 53.755,
   "text": "those tests were scripted,"
  },
  {
   "start": 53.755,
   "end": 56.43,
   "text": "and used no realistic decoys."
  }
 ],
