{
 "subtitles": [
  {
   "start": 0.005,
   "end": 1.591,
   "text": "Where do the chips stop?"
  },
  {
   "start": 2.261,
   "end": 3.531,
   "text": "On the world map,"
  },
  {
   "start": 3.721,
   "end": 5.161,
   "text": "a line leaves Hsinchu"
  },
  {
   "start": 5.161,
   "end": 6.571,
   "text": "and does not arrive."
  },
  {
   "start": 6.941,
   "end": 8.561,
   "text": "Leading-edge chips for phones,"
  },
  {
   "start": 8.561,
   "end": 10.602,
   "text": "cars and servers are delayed."
  },
  {
   "start": 10.602,
   "end": 12.612,
   "text": "One study of a blockade,"
  },
  {
   "start": 12.612,
   "end": 14.209,
   "text": "not a blackout,"
  },
  {
   "start": 14.209,
   "end": 16.321,
   "text": "put the economic activity at risk"
  },
  {
   "start": 16.321,
   "end": 19.138,
   "text": "at well over two trillion dollars."
  },
  {
   "start": 19.293,
   "end": 20.361,
   "text": "We do not apply"
  },
  {
   "start": 20.361,
   "end": 22.031,
   "text": "that figure here."
  },
  {
   "start": 22.512,
   "end": 24.411,
   "text": "How does the world respond?"
  },
  {
   "start": 25.031,
   "end": 26.361,
   "text": "No published model covers"
  },
  {
   "start": 26.361,
   "end": 28.092,
   "text": "a Taiwan blackout,"
  },
  {
   "start": 28.092,
   "end": 30.461,
   "text": "and the CSIS blockade wargames"
  },
  {
   "start": 30.461,
   "end": 32.144,
   "text": "did not model cyber."
  },
  {
   "start": 32.144,
   "end": 33.231,
   "text": "We do not know."
  },
  {
   "start": 33.806,
   "end": 34.858,
   "text": "What we do know"
  },
  {
   "start": 34.858,
   "end": 36.811,
   "text": "is smaller and quieter."
  },
  {
   "start": 37.027,
   "end": 37.861,
   "text": "A grid can fall"
  },
  {
   "start": 37.861,
   "end": 39.467,
   "text": "over without a missile."
  },
  {
   "start": 39.467,
   "end": 41.751,
   "text": "It has before, in Ukraine,"
  },
  {
   "start": 41.912,
   "end": 43.571,
   "text": "and in Taiwan itself."
  },
  {
   "start": 43.925,
   "end": 45.231,
   "text": "This did not happen."
  },
  {
   "start": 45.469,
   "end": 46.571,
   "text": "The lights are on."
  }
 ],
