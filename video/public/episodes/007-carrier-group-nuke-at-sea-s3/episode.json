{
 "subtitles": [
  {
   "start": 0.0,
   "end": 2.132,
   "text": "The burn ring for exposed skin"
  },
  {
   "start": 2.132,
   "end": 4.477,
   "text": "reaches 1.6 km."
  },
  {
   "start": 4.477,
   "end": 6.893,
   "text": "Escorts inside these rings are the"
  },
  {
   "start": 6.893,
   "end": 8.954,
   "text": "ones at risk of heavy damage."
  },
  {
   "start": 9.504,
   "end": 10.642,
   "text": "Look at the scale."
  },
  {
   "start": 10.642,
   "end": 12.348,
   "text": "A destroyer is a dot inside"
  },
  {
   "start": 12.348,
   "end": 14.75,
   "text": "a ring almost 8 km across,"
  },
  {
   "start": 14.75,
   "end": 16.015,
   "text": "so the map draws the"
  },
  {
   "start": 16.015,
   "end": 17.658,
   "text": "ships larger than they are"
  },
  {
   "start": 17.658,
   "end": 19.238,
   "text": "and labels them that way."
  },
  {
   "start": 19.238,
   "end": 20.945,
   "text": "The rings are drawn exactly"
  },
  {
   "start": 20.945,
   "end": 22.715,
   "text": "as the engine computes them."
  },
  {
   "start": 23.265,
   "end": 24.937,
   "text": "The light blast ring,"
  },
  {
   "start": 24.937,
   "end": 27.007,
   "text": "one pound per square inch,"
  },
  {
   "start": 27.007,
   "end": 29.873,
   "text": "reaches 3.9 km."
  },
  {
   "start": 29.873,
   "end": 31.386,
   "text": "The carrier sits at"
  },
  {
   "start": 31.386,
   "end": 32.58,
   "text": "two and a half,"
  },
  {
   "start": 32.58,
   "end": 34.252,
   "text": "between the burn ring"
  },
  {
   "start": 34.252,
   "end": 35.287,
   "text": "and the edge."
  },
  {
   "start": 35.287,
   "end": 37.596,
   "text": "The model puts it between one"
  },
  {
   "start": 37.596,
   "end": 40.143,
   "text": "and five pounds per square inch,"
  },
  {
   "start": 40.143,
   "end": 41.895,
   "text": "outside the burn ring."
  }
