{
 "subtitles": [
  {
   "start": 0.0,
   "end": 1.646,
   "text": "The fireball. Radius,"
  },
  {
   "start": 1.646,
   "end": 4.153,
   "text": "eight hundred and eighty metres."
  },
  {
   "start": 4.153,
   "end": 6.582,
   "text": "Everything inside is vaporised."
  },
  {
   "start": 6.582,
   "end": 7.914,
   "text": "That is about two"
  },
  {
   "start": 7.914,
   "end": 10.187,
   "text": "point four square kilometres,"
  },
  {
   "start": 10.187,
   "end": 11.754,
   "text": "centred on the Loop."
  },
  {
   "start": 12.304,
   "end": 12.706,
   "text": "Next,"
  },
  {
   "start": 12.706,
   "end": 14.397,
   "text": "the twenty pounds per"
  },
  {
   "start": 14.397,
   "end": 15.765,
   "text": "square inch ring."
  },
  {
   "start": 15.765,
   "end": 17.938,
   "text": "One point three kilometres."
  },
  {
   "start": 17.938,
   "end": 20.916,
   "text": "Heavily built concrete structures are"
  },
  {
   "start": 20.916,
   "end": 23.33,
   "text": "severely damaged or destroyed."
  },
  {
   "start": 23.88,
   "end": 25.324,
   "text": "Then the five pounds"
  },
  {
   "start": 25.324,
   "end": 26.84,
   "text": "per square inch ring."
  },
  {
   "start": 26.84,
   "end": 28.788,
   "text": "Six point three kilometres."
  },
  {
   "start": 28.788,
   "end": 30.16,
   "text": "About a hundred and"
  },
  {
   "start": 30.16,
   "end": 32.325,
   "text": "twenty-four square kilometres."
  },
  {
   "start": 32.325,
   "end": 34.635,
   "text": "Most ordinary buildings collapse"
  },
  {
   "start": 34.635,
   "end": 36.295,
   "text": "or are heavily damaged."
  },
  {
   "start": 36.295,
   "end": 37.956,
   "text": "That is the area where,"
  },
  {
   "start": 37.956,
   "end": 39.111,
   "text": "by this measure,"
  },
  {
   "start": 39.111,
   "end": 40.843,
   "text": "ordinary buildings fail."
  }
