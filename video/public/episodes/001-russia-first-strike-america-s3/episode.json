{
 "subtitles": [
  {
   "start": 0.54,
   "end": 1.26,
   "text": "On the ninth of"
  },
  {
   "start": 1.26,
   "end": 2.63,
   "text": "November nineteen seventy-nine,"
  },
  {
   "start": 3.405,
   "end": 4.76,
   "text": "a training tape loaded into"
  },
  {
   "start": 4.76,
   "end": 6.44,
   "text": "a NORAD computer showed a"
  },
  {
   "start": 6.44,
   "end": 8.49,
   "text": "massive Soviet attack under way."
  },
  {
   "start": 9.818,
   "end": 11.28,
   "text": "The national security adviser"
  },
  {
   "start": 11.28,
   "end": 13.55,
   "text": "was woken and told."
  },
  {
   "start": 14.3,
   "end": 15.7,
   "text": "He was minutes from calling"
  },
  {
   "start": 15.7,
   "end": 16.96,
   "text": "the president when it was"
  },
  {
   "start": 16.96,
   "end": 18.43,
   "text": "found to be false."
  },
  {
   "start": 19.45,
   "end": 21.21,
   "text": "In June nineteen eighty,"
  },
  {
   "start": 21.373,
   "end": 23.68,
   "text": "a single faulty computer chip,"
  },
  {
   "start": 23.68,
   "end": 25.608,
   "text": "worth forty-six cents,"
  },
  {
   "start": 25.608,
   "end": 27.1,
   "text": "wrote random numbers into"
  },
  {
   "start": 27.1,
   "end": 28.91,
   "text": "the missile-warning messages."
  },
  {
   "start": 29.347,
   "end": 30.704,
   "text": "Twice in a week,"
  },
  {
   "start": 30.704,
   "end": 32.75,
   "text": "the screens showed an attack."
  },
  {
   "start": 33.302,
   "end": 35.05,
   "text": "In September nineteen eighty-three,"
  },
  {
   "start": 35.728,
   "end": 37.9,
   "text": "a Soviet officer named Stanislav"
  },
  {
   "start": 37.9,
   "end": 40.56,
   "text": "Petrov saw five American missiles"
  },
  {
   "start": 40.56,
   "end": 42.62,
   "text": "on his satellite display and"
  },
  {
   "start": 42.62,
   "end": 44.45,
   "text": "decided it was an error."
  },
  {
   "start": 44.687,
   "end": 45.65,
   "text": "He was right."
  },
  {
   "start": 45.948,
   "end": 47.47,
   "text": "And in nineteen ninety-five,"
  },
  {
   "start": 48.096,
   "end": 50.02,
   "text": "a Norwegian science rocket was"
  },
  {
   "start": 50.02,
   "end": 51.68,
   "text": "read by Russian radar as"
  },
  {
   "start": 51.68,
   "end": 52.99,
   "text": "a possible missile."
  },
  {
   "start": 53.22,
   "end": 56.11,
   "text": "President Yeltsin's nuclear briefcase was opened."
  }
 ],
