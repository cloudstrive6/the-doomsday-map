{
 "subtitles": [
  {
   "start": 0.0,
   "end": 2.074,
   "text": "Minute zero. The launch."
  },
  {
   "start": 2.074,
   "end": 4.667,
   "text": "Radar sees a ballistic missile"
  },
  {
   "start": 4.667,
   "end": 7.432,
   "text": "climbing out of Belgorod region."
  },
  {
   "start": 7.432,
   "end": 10.457,
   "text": "It looks like every other Iskander."
  },
  {
   "start": 10.457,
   "end": 12.617,
   "text": "We assume nobody can tell"
  },
  {
   "start": 12.617,
   "end": 14.778,
   "text": "the difference in flight."
  },
  {
   "start": 15.328,
   "end": 16.103,
   "text": "Minute one."
  },
  {
   "start": 16.103,
   "end": 18.289,
   "text": "Air defence crews have seconds,"
  },
  {
   "start": 18.289,
   "end": 19.134,
   "text": "not minutes."
  },
  {
   "start": 19.134,
   "end": 21.108,
   "text": "A three-minute flight leaves"
  },
  {
   "start": 21.108,
   "end": 22.659,
   "text": "no meaningful warning."
  },
  {
   "start": 23.209,
   "end": 26.043,
   "text": "Minute two. It begins to fall."
  },
  {
   "start": 26.043,
   "end": 27.46,
   "text": "Over the field,"
  },
  {
   "start": 27.46,
   "end": 29.917,
   "text": "a staging area of vehicles"
  },
  {
   "start": 29.917,
   "end": 31.995,
   "text": "and tents sits under a"
  },
  {
   "start": 31.995,
   "end": 33.507,
   "text": "cold winter sky."
  },
  {
   "start": 34.057,
   "end": 35.383,
   "text": "Minute three."
  },
  {
   "start": 35.383,
   "end": 38.239,
   "text": "The warhead detonates in the"
  },
  {
   "start": 38.239,
   "end": 40.279,
   "text": "air above the field."
  },
  {
   "start": 40.279,
   "end": 42.115,
   "text": "Not on the ground."
  },
  {
   "start": 42.665,
   "end": 44.012,
   "text": "There is a flash"
  },
  {
   "start": 44.012,
   "end": 45.863,
   "text": "brighter than the sun."
  },
  {
   "start": 45.863,
   "end": 47.21,
   "text": "Then a fireball."
  },
  {
   "start": 47.21,
   "end": 49.735,
   "text": "Then a shock wave that crosses"
  },
  {
   "start": 49.735,
   "end": 52.175,
   "text": "the field faster than a sound"
  },
  {
   "start": 52.175,
   "end": 54.7,
   "text": "can reach anyone to warn them."
  }
 ],
